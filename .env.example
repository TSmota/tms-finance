# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms_finance?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-strong-secret"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------
# Superfície de agente (endpoint MCP em /api/agent/mcp)
# ---------------------------------------------------------------

# Pepper do HMAC dos tokens de agente, e chave do requestState de confirmação.
# Mínimo 32 caracteres. Gere com: openssl rand -base64 33
AGENT_TOKEN_PEPPER=""

# Chamadas por minuto por token. Default 60. Contém loop desgovernado do
# agente, não é medida anti-fraude — o token já é a autenticação.
AGENT_RATE_LIMIT_PER_MINUTE=""

# Validade do requestState de confirmação de remoção, em segundos. Default 120.
AGENT_CONFIRM_TTL_SECONDS=""

# ---------------------------------------------------------------
# Rotinas agendadas (vercel.json)
# ---------------------------------------------------------------

# Segredo do `Authorization: Bearer` das rotas em /api/cron/*. Sem ele as rotas
# recusam tudo, de propósito. Gere com: openssl rand -base64 33
CRON_SECRET=""

# ---------------------------------------------------------------
# Banco
# ---------------------------------------------------------------

# Conexões por instância. Default 5 — pequeno porque em serverless quem cresce
# é o número de instâncias. Num processo de longa duração, aumente.
DB_POOL_MAX=""
