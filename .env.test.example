# Banco exclusivo dos testes. É TRUNCADO a cada teste, e `tests/global-setup.ts`
# recusa rodar se o nome não contiver `tms_finance_test`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms_finance_test?schema=public"

AUTH_SECRET="test-secret-not-used-outside-the-test-database"

# Mínimo 32 caracteres: os testes da superfície MCP emitem tokens de verdade.
AGENT_TOKEN_PEPPER="test-pepper-with-at-least-32-characters"
